# Copy this file to .env.local and fill in real values. Never commit
# .env.local itself. Prefer `clerk env pull` (run from frontend/) over
# filling this in by hand, once the project is linked to a Clerk app.
#
# Only VITE_-prefixed vars are exposed to client code by Vite - a
# CLERK_SECRET_KEY (backend-only) has no business being in this file.

VITE_CLERK_PUBLISHABLE_KEY=
