# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=3000

# MongoDB connection string
MONGODB_URI=

# TheDogAPI - https://thedogapi.com/
DOG_API_KEY=

# Cloudinary - https://cloudinary.com/ (dashboard home page after signup)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Clerk - https://clerk.com/ (run `clerk env pull` from backend/ instead of
# filling these in by hand, once the project is linked to a Clerk app)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
